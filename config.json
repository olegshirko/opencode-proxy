{
  "listen": "127.0.0.1:4000",
  "upstream": "https://opencode.ai/inference/go/anthropic",
  "session_fallback": "my-session-1",
  "log": {
    "file": "/Users/oleg/opencode-proxy/proxy.log",
    "level": "info",
    "max_mb": 10,
    "keep": 5,
    "capture": {
      "request_headers": false,
      "request_body": false,
      "response_headers": false,
      "response_body": false
    },
    "max_body_bytes": 65536
  },
  "models": {
    "default": "deepseek-v4.1-flash",
    "background": "deepseek-v4.1-flash",
    "aliases": {
      "claude-sonnet-5": "deepseek-v4.1-flash",
      "claude-v151-flash": "deepseek-v4.1-flash",
      "claude-v4.1-flash": "deepseek-v4.1-flash"
    }
  },
  "retry": {
    "max_attempts": 5,
    "first_wait_ms": 2000,
    "multiplier": 2,
    "max_wait_ms": 15000,
    "total_budget_ms": 60000
  },
  "admin": {
    "enabled": true,
    "token": ""
  },
  "scheduler": {
    "max_concurrent_cells": 8,
    "queue_timeout_ms": 60000,
    "keepalive_after_ms": 3000,
    "keepalive_interval_ms": 5000,
    "fallback_after_ms": 20000,
    "fallback_rotate_main": false,
    "thinking_summary_wait_ms": 500
  },
  "connect_timeout_seconds": 15,
  "session_cost_file": "/Users/oleg/opencode-proxy/session-cost.json",
  "usage_file": "/Users/oleg/opencode-proxy/usage.json",
  "limits": {
    "monthly_usd": 30,
    "five_hour_fraction": 0.4,
    "weekly_fraction": 0.5,
    "warning_fraction": 0.85,
    "month_start": "2026-11-06T21:00:00+03:00"
  }
}
