<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.opencode.proxy</string>
  <key>ProgramArguments</key>
  <array>
    <string>__BIN__</string>
    <string>-config</string>
    <string>__HOME__/opencode-proxy/config.json</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__HOME__/opencode-proxy</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>StandardOutPath</key>
  <string>__HOME__/opencode-proxy/service.out.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/opencode-proxy/service.err.log</string>
</dict>
</plist>
